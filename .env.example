# Copy this template to .env and paste your Gemini API key.
GEMINI_API_KEY=

# Generation model failover order. Embeddings use GEMINI_EMBEDDING_MODEL below;
# embedding fallback is disabled because one index must use a single embedding space.
GEMINI_GENERATION_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_GENERATION_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Maximum time for each Gemini HTTP request (milliseconds).
GEMINI_REQUEST_TIMEOUT_MS=45000
GEMINI_MODEL_COOLDOWN_SECONDS=300
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=false
RERANKER_CANDIDATES=40
EVIDENCE_TOKEN_BUDGET=6000
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=3072
